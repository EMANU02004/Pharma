        "body": {
          "mode": "raw",
          "raw": "{\n  \"patient_id\": 1,\n  \"items\": [\n    {\n      \"medicine_id\": 1,\n      \"dose\": \"\",\n      \"frequency\": \"Twice daily\",\n      \"duration_days\": 30,\n      \"quantity\": 60\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
