    {
      "name": "Patient: search medicine by name",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/search/medicine?q=metformin&lat=0.5143&lng=35.2698&sort=distance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "search",
            "medicine"
          ],
          "query": [
            {
              "key": "q",
              "value": "metformin"
            },
            {
              "key": "lat",
              "value": "0.5143"
            },
            {
              "key": "lng",
              "value": "35.2698"
            },
            {
              "key": "sort",
              "value": "distance"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json().results;",
              "pm.test(\"Sorted nearest first\", () => { for (let i=1;i<r.length;i++) pm.expect(r[i].distance_km).to.be.at.least(r[i-1].distance_km); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Patient: pharmacies for prescription",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/patient/prescriptions/{{rxId}}/pharmacies?lat=0.5143&lng=35.2698",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "patient",
            "prescriptions",
            "{{rxId}}",
            "pharmacies"
          ],
          "query": [
            {
              "key": "lat",
              "value": "0.5143"
            },
            {
              "key": "lng",
              "value": "35.2698"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json().results;",
              "const best = r.find(p => p.can_fill_all);",
              "pm.collectionVariables.set(\"pharmacyId\", best ? best.pharmacy_id : r[0].pharmacy_id);",
              "pm.test(\"Full-coverage pharmacies listed first\", () => { const i = r.findIndex(p => !p.can_fill_all); if (i>=0) pm.expect(r.slice(i).every(p => !p.can_fill_all)).to.be.true; });"
            ]
          }
        }
      ]
    },
