    {
      "name": "Doctor: create prescription",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/doctor/prescriptions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "doctor",
            "prescriptions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patient_id\": 1,\n  \"valid_days\": 30,\n  \"items\": [\n    {\n      \"medicine_id\": 1,\n      \"dose\": \"1 tablet\",\n      \"frequency\": \"Twice daily\",\n      \"duration_days\": 30,\n      \"quantity\": 60\n    },\n    {\n      \"medicine_id\": 9,\n      \"dose\": \"1 tablet\",\n      \"frequency\": \"Once daily\",\n      \"duration_days\": 30,\n      \"quantity\": 30\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const rx = pm.response.json();",
              "pm.test(\"Code has XXXX-XXXX format\", () => pm.expect(rx.code).to.match(/^[A-Z2-9]{4}-[A-Z2-9]{4}$/));",
              "pm.collectionVariables.set(\"rxId\", rx.prescription_id);",
              "pm.collectionVariables.set(\"rxCode\", rx.code);"
            ]
          }
        }
      ]
    },
