# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pharma
DB_PASSWORD=pharma_dev
DB_NAME=pharmafinder
# For hosted MySQL that requires TLS (e.g. Aiven), path to the CA certificate:
# DB_SSL_CA=certs/ca.pem

# Set to true when served over HTTPS (Vercel)
SESSION_COOKIE_SECURE=false

# Optional: real email delivery for notifications. Leave blank to use
# in-app notifications marked "simulated".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PharmaFinder <no-reply@example.com>

# Password given to every seeded demo account
DEMO_PASSWORD=Pharma2026
